# Dockerfile.python --- epykit Python stack for reproducible benchmarks.
#
# Phase 1.4 of the GB resubmission plan: ship a container that a third
# reader can build from a clean checkout and use to reproduce every
# headline number in benchmark/paper_data/ end to end. uv is the
# canonical installer (matches CI in .github/workflows/test.yml).
#
# Usage:
#   docker build -t epykit-py -f Dockerfile.python .
#   docker run --rm -v "$PWD":/work -w /work epykit-py \
#       uv run pytest -m "not slow" --strict-markers -ra
#   docker run --rm -v "$PWD":/work -w /work epykit-py \
#       uv run python benchmark/scripts/regen_small.py
#
# Pinning policy: Python is 3.12.* from the base image (matches
# .python-version and the CI matrix); uv is a pinned release copied from
# its official image (keep in step with UV_VERSION in
# .github/workflows/test.yml). System libraries needed by polars, pyarrow,
# numpy and the optional Bismark/MethylDackel converters are installed
# via apt with explicit version-free names -- the Debian-slim base layer
# is the pinned anchor for those.
FROM python:3.12-slim-bookworm

# Avoid prompts in apt and ensure UTF-8 throughout the toolchain.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONIOENCODING=utf-8 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PIP_NO_CACHE_DIR=1

# System deps:
#   - build-essential, gcc, gfortran: scipy / pyarrow native builds
#   - libcurl4, libssl-dev, ca-certificates: HTTP for nf-core ingestion
#   - zlib1g, libbz2, liblzma: tabix / pyBigWig (where supported)
#   - zlib1g-dev, libcurl4-openssl-dev: headers for building pyBigWig from
#     source on platforms without a wheel (linux/arm64)
#   - git: epykit benchmarks read git provenance for MANIFEST.txt files
#   - tini: PID-1 reaping so docker stop exits cleanly
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential gcc gfortran \
        ca-certificates curl git tini \
        libcurl4 libssl-dev \
        zlib1g libbz2-1.0 liblzma5 \
        zlib1g-dev libcurl4-openssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Install a pinned uv release by copying the static binary out of the
# official image -- no installer script, no "latest" drift.
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

WORKDIR /work

# The environment lives outside /work so the documented
# `-v "$PWD":/work` bind mount cannot shadow it (and cannot clobber a
# host-side .venv). `uv run` in the container finds it through this
# variable.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# Pre-install dependencies BEFORE copying source so the layer cache only
# busts on pyproject.toml / uv.lock changes. The full source is
# volume-mounted at run time via -v "$PWD":/work; what we copy here is
# just enough for `uv sync --locked` to reproduce the locked environment.
# --no-install-project: src/ is not in this layer, so epykit itself is
# installed (editable) by the first `uv run` against the mounted source.
COPY pyproject.toml uv.lock .python-version ./

RUN uv sync --locked --extra all --no-install-project

# Default entrypoint is tini -> the user's command. uv is on PATH so
# `docker run epykit-py uv run pytest ...` works directly.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash"]
